# Sunny MCP Server Configuration
# The sunny-mcp binary reads these from its environment; copy to .env and
# source it, or set them in your MCP client configuration.

# Ableton connection (opt-in). Unset SUNNY_ABLETON_HOST to run offline:
# theory and IR tools work, Ableton-mutating tools decline loudly.
# Under WSL2 connecting to Ableton on the Windows host, use the host IP
# from /etc/resolv.conf.
SUNNY_ABLETON_HOST=127.0.0.1
# Inside Docker Desktop use host.docker.internal for Live on the host, or a
# LAN address for another computer. Container 127.0.0.1 is the container itself.
# Linux Engine also needs --add-host host.docker.internal:host-gateway.
# Export /opt/sunny/remote-script/Sunny with docker cp from the same image ID
# used by the MCP client; protocol 46 plus source SHA256 must match.

# Port of the Sunny Remote Script TCP server inside Ableton (default 9001).
SUNNY_TCP_PORT=9001

# Optional native-server startup restore. Docker defaults to this path; mount
# a named volume at /data and call workspace_save with this path before exiting.
# SUNNY_WORKSPACE_PATH=/data/workspace.sunny.json
# Explicitly restore a supported .bak if the main file is corrupt. This does
# not repair the main file; save the recovered workspace afterward.
# SUNNY_WORKSPACE_RECOVERY=backup

# Remote Script listener, set in the environment Live starts with. Keep
# loopback unless sunny-mcp runs on another machine or in a container; then use
# 0.0.0.0 and allow TCP 9001 from that machine only in the host firewall.
SUNNY_BIND_HOST=127.0.0.1
